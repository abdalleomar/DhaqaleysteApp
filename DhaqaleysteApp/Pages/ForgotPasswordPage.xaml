<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DhaqaleysteApp.Pages.ForgotPasswordPage"
             Title="Forgot password"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,24" Spacing="16">
            <Border Style="{StaticResource FloatingCircle}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1"
                    HorizontalOptions="Start" SemanticProperties.Description="Back">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="Back_Tapped" /></Border.GestureRecognizers>
                <Label Text="{StaticResource IconBack}" Style="{StaticResource Icon}" FontSize="26" />
            </Border>

            <Border WidthRequest="56" HeightRequest="56" StrokeThickness="0" StrokeShape="RoundRectangle 16" HorizontalOptions="Start"
                    BackgroundColor="{DynamicResource PrimarySoftColor}" Margin="0,8,0,0">
                <Label Text="{StaticResource IconEmail}" Style="{StaticResource Icon}" FontSize="26" TextColor="{DynamicResource PrimaryColor}" />
            </Border>

            <VerticalStackLayout Spacing="4">
                <Label Text="Forgot password" Style="{StaticResource TitleText}" />
                <Label x:Name="SubtitleLabel" Text="Enter your staff email. We will send you a 6-digit code." FontSize="15" LineHeight="1.3" TextColor="{DynamicResource TextTertiaryColor}" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="6">
                <Label Text="Email" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBox}">
                    <Entry x:Name="EmailEntry" Keyboard="Email" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                </Border>
            </VerticalStackLayout>
            <VerticalStackLayout x:Name="CodeSection" Spacing="16" IsVisible="False">
            <VerticalStackLayout Spacing="6">
                <Label Text="6-digit code from the email" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBox}">
                    <Entry x:Name="CodeEntry" Keyboard="Numeric" MaxLength="6" />
                </Border>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="6">
                <Label Text="New password" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBox}">
                    <Entry x:Name="NewPasswordEntry" IsPassword="True" />
                </Border>
                <Label Text="At least 8 characters, with letters and numbers." FontSize="12" TextColor="{DynamicResource TextTertiaryColor}" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="6">
                <Label Text="Confirm new password" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBox}">
                    <Entry x:Name="ConfirmEntry" IsPassword="True" />
                </Border>
            </VerticalStackLayout>
                <Label Text="Send a new code" Style="{StaticResource LinkText}" HorizontalOptions="Start">
                    <Label.GestureRecognizers><TapGestureRecognizer Tapped="Resend_Tapped" /></Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>

            <Label x:Name="ErrorLabel" Style="{StaticResource ErrorText}" IsVisible="False" />
            <Button x:Name="SubmitButton" HeightRequest="54" Clicked="Submit_Clicked" />
            <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
