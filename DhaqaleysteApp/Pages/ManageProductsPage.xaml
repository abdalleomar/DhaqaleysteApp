<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="DhaqaleysteApp.Pages.ManageProductsPage"
    Title="Manage Products"
    BackgroundColor="{DynamicResource PageBackgroundColor}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="15,10">

        <Grid ColumnDefinitions="*,Auto">
            <Label Text="Manage Products"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource PrimaryColor}"
                   VerticalOptions="Center"/>
            <Button Grid.Column="1" Text="+ Add" Clicked="Add_Clicked"
                    BackgroundColor="{DynamicResource PrimaryColor}" TextColor="{DynamicResource OnPrimaryColor}"/>
        </Grid>

        <SearchBar Grid.Row="1"
                   x:Name="SearchBarProducts"
                   Margin="0,8"
                   Placeholder="Search products..."
                   TextChanged="Search_TextChanged"/>

        <RefreshView Grid.Row="2" x:Name="Refresh" Refreshing="Refresh_Refreshing">
            <CollectionView ItemsSource="{Binding Products}"
                            RemainingItemsThreshold="5"
                            RemainingItemsThresholdReached="Products_RemainingItemsThresholdReached">

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                        <ActivityIndicator x:Name="LoadingIndicator" IsRunning="True" Color="{DynamicResource PrimaryColor}"/>
                        <Label x:Name="EmptyLabel"
                               Text="No products to manage"
                               IsVisible="False"
                               HorizontalTextAlignment="Center"/>
                        <Button x:Name="RetryButton"
                                Text="Try again"
                                IsVisible="False"
                                Clicked="Retry_Clicked"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.Footer>
                    <ActivityIndicator x:Name="LoadMoreIndicator" IsRunning="False" IsVisible="False" Margin="0,10" Color="{DynamicResource PrimaryColor}"/>
                </CollectionView.Footer>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="{DynamicResource BorderColor}"
                                StrokeThickness="1"
                                BackgroundColor="{DynamicResource SurfaceColor}"
                                Padding="12"
                                Margin="0,0,0,10">

                            <Grid ColumnDefinitions="72,*" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                                <Image Source="{Binding ImageUrl}"
                                       WidthRequest="72" HeightRequest="72"
                                       Aspect="AspectFill"
                                       BackgroundColor="{DynamicResource SurfaceVariantColor}"
                                       VerticalOptions="Start"/>

                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="{Binding ProductName}" FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource TextPrimaryColor}"/>
                                    <Label Text="{Binding CategoryName}" FontSize="13" TextColor="{DynamicResource PrimaryColor}"/>
                                    <Label Text="{Binding PriceText}" TextColor="{DynamicResource SuccessColor}" FontAttributes="Bold"/>
                                    <Label Text="{Binding StaffStockText}" FontSize="13" TextColor="{DynamicResource TextSecondaryColor}"/>
                                </VerticalStackLayout>

                                <FlexLayout Grid.Row="1" Grid.ColumnSpan="2" Wrap="Wrap" Margin="0,8,0,0">
                                    <Button Text="Edit" Clicked="Edit_Clicked" Margin="0,0,8,6"
                                            BackgroundColor="{DynamicResource PrimaryColor}" TextColor="{DynamicResource OnPrimaryColor}"/>
                                    <Button Text="{Binding AvailabilityActionText}" Clicked="ToggleAvailable_Clicked" Margin="0,0,8,6"/>
                                    <Button Text="{Binding FeaturedActionText}" Clicked="ToggleFeatured_Clicked" Margin="0,0,8,6"/>
                                    <Button Text="Delete" Clicked="Delete_Clicked" Margin="0,0,8,6"
                                            BackgroundColor="{DynamicResource DangerColor}" TextColor="{DynamicResource OnPrimaryColor}"/>
                                </FlexLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
