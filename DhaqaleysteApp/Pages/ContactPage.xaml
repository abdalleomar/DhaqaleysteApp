<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DhaqaleysteApp.ViewModels"
             xmlns:views="clr-namespace:DhaqaleysteApp.Views"
             xmlns:loc="clr-namespace:DhaqaleysteApp.Services.Localization"
             x:Class="DhaqaleysteApp.Pages.ContactPage"
             x:DataType="vm:ContactViewModel"
             Title="{loc:Translate ContactTitle}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">
        <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="20,20,20,16" Spacing="14">

                    <!-- Company card -->
                    <Border Style="{StaticResource BigCard}" Padding="18">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="56,*" ColumnSpacing="14">
                                <Border WidthRequest="56" HeightRequest="56" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                                        BackgroundColor="{DynamicResource PrimaryColor}">
                                    <Grid>
                                        <Label Text="{StaticResource IconStore}" Style="{StaticResource Icon}" FontSize="28"
                                               TextColor="{DynamicResource OnPrimaryColor}" />
                                        <Image Source="{Binding LogoUrl}" Aspect="AspectFill" IsVisible="{Binding HasLogo}" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding Company.CompanyName}" FontFamily="Heading" FontSize="20" />
                                    <HorizontalStackLayout Spacing="6" IsVisible="{Binding HasHours}">
                                        <Ellipse WidthRequest="8" HeightRequest="8" Fill="{DynamicResource OpenDotColor}" VerticalOptions="Center" />
                                        <Label Text="{Binding Company.WorkingHours}" FontSize="13" FontFamily="BodySemibold"
                                               TextColor="{DynamicResource SuccessColor}" LineBreakMode="TailTruncation" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                            <Label Text="{Binding About}" FontSize="14" LineHeight="1.4" TextColor="{DynamicResource TextSecondaryColor}"
                                   IsVisible="{Binding HasAbout}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button Text="{loc:Translate Call}" Style="{StaticResource OutlineButton}" Command="{Binding CallCommand}"
                                        IsVisible="{Binding HasPhone}">
                                    <Button.ImageSource>
                                        <FontImageSource FontFamily="Icons" Glyph="{StaticResource IconCall}" Size="18" Color="{DynamicResource TextPrimaryColor}" />
                                    </Button.ImageSource>
                                </Button>
                                <Button Grid.Column="1" Text="{loc:Translate WhatsApp}" Style="{StaticResource WhatsAppButton}"
                                        Command="{Binding WhatsAppCommand}" IsVisible="{Binding HasWhatsApp}">
                                    <Button.ImageSource>
                                        <FontImageSource FontFamily="Icons" Glyph="{StaticResource IconWhatsApp}" Size="18" Color="White" />
                                    </Button.ImageSource>
                                </Button>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <views:StateView IsVisible="{Binding ShowState}"
                                     IsLoading="{Binding IsLoading}"
                                     Icon="{Binding StateIcon}"
                                     Title="{Binding StateTitle}"
                                     Message="{Binding StateMessage}"
                                     ActionText="{Binding StateActionText}"
                                     ActionCommand="{Binding RefreshCommand}" />

                    <!-- Details -->
                    <Border Style="{StaticResource BigCard}" Padding="0" IsVisible="{Binding HasAnyContact}">
                        <VerticalStackLayout>
                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="14" Padding="16,12" IsVisible="{Binding HasAddress}">
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenMapCommand}" /></Grid.GestureRecognizers>
                            <Border Style="{StaticResource IconSquare}">
                                <Label Text="{StaticResource IconLocation}" Style="{StaticResource Icon}" FontSize="20" TextColor="{DynamicResource PrimaryColor}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{loc:Translate Address}" FontSize="12" TextColor="{DynamicResource TextTertiaryColor}" />
                                <Label Text="{Binding FullAddress}" FontSize="15" FontFamily="BodyMedium" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{loc:Translate Map}" Style="{StaticResource LinkText}" VerticalOptions="Center" IsVisible="{Binding HasMap}" />
                        </Grid>
                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="14" Padding="16,12" IsVisible="{Binding HasHours}">
                            
                            <Border Style="{StaticResource IconSquare}">
                                <Label Text="{StaticResource IconSchedule}" Style="{StaticResource Icon}" FontSize="20" TextColor="{DynamicResource PrimaryColor}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{loc:Translate WorkingHours}" FontSize="12" TextColor="{DynamicResource TextTertiaryColor}" />
                                <Label Text="{Binding Company.WorkingHours}" FontSize="15" FontFamily="BodyMedium" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="14" Padding="16,12" IsVisible="{Binding HasPhone}">
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding CallCommand}" /></Grid.GestureRecognizers>
                            <Border Style="{StaticResource IconSquare}">
                                <Label Text="{StaticResource IconCall}" Style="{StaticResource Icon}" FontSize="20" TextColor="{DynamicResource PrimaryColor}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{loc:Translate Phone}" FontSize="12" TextColor="{DynamicResource TextTertiaryColor}" />
                                <Label Text="{Binding Company.Phone}" FontSize="15" FontFamily="BodyMedium" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{StaticResource IconChevron}" Style="{StaticResource Icon}" FontSize="20" TextColor="{DynamicResource TextTertiaryColor}" />
                        </Grid>
                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="14" Padding="16,12" IsVisible="{Binding HasEmail}">
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding EmailCommand}" /></Grid.GestureRecognizers>
                            <Border Style="{StaticResource IconSquare}">
                                <Label Text="{StaticResource IconEmail}" Style="{StaticResource Icon}" FontSize="20" TextColor="{DynamicResource PrimaryColor}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{loc:Translate Email}" FontSize="12" TextColor="{DynamicResource TextTertiaryColor}" />
                                <Label Text="{Binding Company.Email}" FontSize="15" FontFamily="BodyMedium" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{StaticResource IconChevron}" Style="{StaticResource Icon}" FontSize="20" TextColor="{DynamicResource TextTertiaryColor}" />
                        </Grid>
                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="14" Padding="16,12" IsVisible="{Binding HasWebsite}">
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenWebsiteCommand}" /></Grid.GestureRecognizers>
                            <Border Style="{StaticResource IconSquare}">
                                <Label Text="{StaticResource IconPublic}" Style="{StaticResource Icon}" FontSize="20" TextColor="{DynamicResource PrimaryColor}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{loc:Translate Website}" FontSize="12" TextColor="{DynamicResource TextTertiaryColor}" />
                                <Label Text="{Binding Company.WebsiteUrl}" FontSize="15" FontFamily="BodyMedium" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{StaticResource IconChevron}" Style="{StaticResource Icon}" FontSize="20" TextColor="{DynamicResource TextTertiaryColor}" />
                        </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Social -->
                    <FlexLayout Wrap="Wrap" IsVisible="{Binding HasSocial}">
                        <Button Text="Facebook" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                Command="{Binding OpenFacebookCommand}" IsVisible="{Binding HasFacebook}" />
                        <Button Text="Instagram" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                Command="{Binding OpenInstagramCommand}" IsVisible="{Binding HasInstagram}" />
                        <Button Text="TikTok" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                Command="{Binding OpenTikTokCommand}" IsVisible="{Binding HasTikTok}" />
                    </FlexLayout>

                    <!-- Settings -->
                    <Border Style="{StaticResource BigCard}">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                    <Label Text="{StaticResource IconLanguage}" Style="{StaticResource Icon}" FontSize="20" TextColor="{DynamicResource PrimaryColor}" />
                                    <Label Text="{loc:Translate Language}" FontFamily="BodySemibold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="3"
                                        BackgroundColor="{DynamicResource SegmentBackgroundColor}">
                                    <HorizontalStackLayout>
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="12,0" HeightRequest="34">
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SetLanguageCommand}" CommandParameter="en" /></Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsEnglish}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="English" FontSize="13" FontFamily="BodyMedium" VerticalOptions="Center" TextColor="{DynamicResource TextTertiaryColor}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsEnglish}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
                                                <Setter Property="FontFamily" Value="BodySemibold" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="12,0" HeightRequest="34">
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SetLanguageCommand}" CommandParameter="so" /></Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSomali}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="Soomaali" FontSize="13" FontFamily="BodyMedium" VerticalOptions="Center" TextColor="{DynamicResource TextTertiaryColor}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSomali}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
                                                <Setter Property="FontFamily" Value="BodySemibold" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                    <Label Text="{StaticResource IconDarkMode}" Style="{StaticResource Icon}" FontSize="20" TextColor="{DynamicResource PrimaryColor}" />
                                    <Label Text="{loc:Translate Theme}" FontFamily="BodySemibold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="3"
                                        BackgroundColor="{DynamicResource SegmentBackgroundColor}">
                                    <HorizontalStackLayout>
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="12,0" HeightRequest="34">
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SetThemeCommand}" CommandParameter="auto" /></Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding ThemeIsAuto}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{loc:Translate ThemeAuto}" FontSize="13" FontFamily="BodyMedium" VerticalOptions="Center" TextColor="{DynamicResource TextTertiaryColor}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding ThemeIsAuto}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
                                                <Setter Property="FontFamily" Value="BodySemibold" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="12,0" HeightRequest="34">
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SetThemeCommand}" CommandParameter="light" /></Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding ThemeIsLight}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{loc:Translate ThemeLight}" FontSize="13" FontFamily="BodyMedium" VerticalOptions="Center" TextColor="{DynamicResource TextTertiaryColor}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding ThemeIsLight}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
                                                <Setter Property="FontFamily" Value="BodySemibold" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="12,0" HeightRequest="34">
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SetThemeCommand}" CommandParameter="dark" /></Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding ThemeIsDark}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{loc:Translate ThemeDark}" FontSize="13" FontFamily="BodyMedium" VerticalOptions="Center" TextColor="{DynamicResource TextTertiaryColor}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding ThemeIsDark}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
                                                <Setter Property="FontFamily" Value="BodySemibold" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Staff entrance -->
                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" HeightRequest="44" Margin="0,4,0,8">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenStaffCommand}" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <Label Text="{StaticResource IconLock}" Style="{StaticResource Icon}" FontSize="16" TextColor="{DynamicResource TextTertiaryColor}" />
                        <Label Text="{Binding StaffText}" FontSize="14" FontFamily="BodySemibold" VerticalOptions="Center"
                               TextColor="{DynamicResource TextTertiaryColor}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <views:TabBarView Grid.Row="1" Current="contact" />
    </Grid>
</ContentPage>
