<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DhaqaleysteApp.ViewModels"
             xmlns:models="clr-namespace:DhaqaleysteApp.Models"
             xmlns:views="clr-namespace:DhaqaleysteApp.Views"
             xmlns:loc="clr-namespace:DhaqaleysteApp.Services.Localization"
             x:Class="DhaqaleysteApp.Pages.ProductListPage"
             x:DataType="vm:ProductListViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Search -->
        <Border Style="{StaticResource InputBox}" Margin="16,8,16,4" Padding="8,0">
            <SearchBar x:Name="Search" Text="{Binding SearchText}" Placeholder="{loc:Translate SearchPlaceholder}" />
        </Border>

        <!-- Result count and filters -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Padding="16,4">
            <Label Text="{Binding ResultsText}" Style="{StaticResource CaptionText}" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="{Binding FiltersText}" Style="{StaticResource SecondaryButton}"
                    Command="{Binding OpenFiltersCommand}" Padding="14,6" MinimumHeightRequest="38" />
        </Grid>

        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}"
                     IsVisible="{Binding ShowContent}">
            <CollectionView ItemsSource="{Binding Products}"
                            RemainingItemsThreshold="6"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                            SelectionMode="None"
                            Margin="10,0">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Product">
                        <Grid Padding="6">
                            <views:ProductCard>
                                <views:ProductCard.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProductListViewModel}}, Path=OpenProductCommand, x:DataType=vm:ProductListViewModel}"
                                        CommandParameter="{Binding .}" />
                                </views:ProductCard.GestureRecognizers>
                            </views:ProductCard>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <ActivityIndicator IsRunning="{Binding IsLoadingMoreVisible}" IsVisible="{Binding IsLoadingMoreVisible}"
                                       Margin="0,12,0,24" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <views:StateView Grid.Row="2"
                         IsVisible="{Binding ShowState}"
                         IsLoading="{Binding IsLoading}"
                         Icon="{Binding StateIcon}"
                         Title="{Binding StateTitle}"
                         Message="{Binding StateMessage}"
                         ActionText="{loc:Translate TryAgain}"
                         ActionCommand="{Binding RetryCommand}" />
    </Grid>
</ContentPage>
