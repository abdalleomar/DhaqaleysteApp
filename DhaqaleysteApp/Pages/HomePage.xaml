<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DhaqaleysteApp.ViewModels"
             xmlns:models="clr-namespace:DhaqaleysteApp.Models"
             xmlns:views="clr-namespace:DhaqaleysteApp.Views"
             xmlns:loc="clr-namespace:DhaqaleysteApp.Services.Localization"
             x:Class="DhaqaleysteApp.Pages.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="{loc:Translate TabHome}"
             Shell.NavBarIsVisible="False">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
        <CollectionView ItemsSource="{Binding NewArrivals}"
                        RemainingItemsThreshold="6"
                        RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                        SelectionMode="None">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <VerticalStackLayout Spacing="18" Padding="16,12,16,4">

                    <!-- Brand header -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0"
                                StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource PrimaryColor}">
                            <Label Text="{StaticResource IconStore}" Style="{StaticResource Icon}"
                                   TextColor="{DynamicResource OnPrimaryColor}" />
                        </Border>
                        <Label Grid.Column="1" Text="{Binding CompanyName}" Style="{StaticResource HeadlineText}"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- Search box: opens the search screen -->
                    <Border Style="{StaticResource InputBox}" Padding="14,0" HeightRequest="48">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenSearchCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="{StaticResource IconSearch}" Style="{StaticResource Icon}" />
                            <Label Grid.Column="1" Text="{loc:Translate SearchPlaceholder}" VerticalOptions="Center"
                                   TextColor="{DynamicResource PlaceholderColor}" />
                        </Grid>
                    </Border>

                    <!-- Categories -->
                    <CollectionView ItemsSource="{Binding Categories}" IsVisible="{Binding HasCategories}"
                                    HeightRequest="40" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Category">
                                <Border Style="{StaticResource Chip}" VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=OpenCategoryCommand, x:DataType=vm:HomeViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding DisplayName}" FontSize="14" FontFamily="OpenSansSemibold" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Featured -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding HasFeatured}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{loc:Translate Featured}" Style="{StaticResource SectionTitleText}" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="{loc:Translate SeeAll}" Style="{StaticResource TextButton}"
                                    Command="{Binding SeeAllFeaturedCommand}" />
                        </Grid>
                        <CollectionView ItemsSource="{Binding Featured}" HeightRequest="262" SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Product">
                                    <views:ProductCard WidthRequest="170">
                                        <views:ProductCard.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=OpenProductCommand, x:DataType=vm:HomeViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </views:ProductCard.GestureRecognizers>
                                    </views:ProductCard>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- Recently viewed (saved on this phone) -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding HasRecent}">
                        <Label Text="{loc:Translate RecentlyViewed}" Style="{StaticResource SectionTitleText}" />
                        <CollectionView ItemsSource="{Binding Recent}" HeightRequest="96" SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Product">
                                    <Border Style="{StaticResource Card}" Padding="0" WidthRequest="220" HeightRequest="90">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=OpenProductCommand, x:DataType=vm:HomeViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="90,*">
                                            <Grid BackgroundColor="{DynamicResource SurfaceVariantColor}">
                                                <Label Text="{StaticResource IconStore}" Style="{StaticResource Icon}"
                                                       TextColor="{DynamicResource TextTertiaryColor}" />
                                                <Image Source="{Binding ImageUrl}" Aspect="AspectFill" IsVisible="{Binding HasImage}" />
                                            </Grid>
                                            <VerticalStackLayout Grid.Column="1" Padding="10,8" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding ProductName}" FontFamily="OpenSansSemibold" FontSize="14"
                                                       MaxLines="2" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding PriceText}" Style="{StaticResource PriceText}" FontSize="14" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- New arrivals title (the grid below is the main list) -->
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowContent}">
                        <Label Text="{loc:Translate NewArrivals}" Style="{StaticResource SectionTitleText}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="{loc:Translate SeeAll}" Style="{StaticResource TextButton}"
                                Command="{Binding SeeAllProductsCommand}" />
                    </Grid>

                    <views:StateView IsVisible="{Binding ShowState}"
                                     IsLoading="{Binding IsLoading}"
                                     Icon="{Binding StateIcon}"
                                     Title="{Binding StateTitle}"
                                     Message="{Binding StateMessage}"
                                     ActionText="{Binding StateActionText}"
                                     ActionCommand="{Binding RetryCommand}" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Product">
                    <Grid Padding="6">
                        <views:ProductCard>
                            <views:ProductCard.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=OpenProductCommand, x:DataType=vm:HomeViewModel}"
                                    CommandParameter="{Binding .}" />
                            </views:ProductCard.GestureRecognizers>
                        </views:ProductCard>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <ActivityIndicator IsRunning="{Binding IsLoadingMoreVisible}" IsVisible="{Binding IsLoadingMoreVisible}"
                                   Margin="0,12,0,24" />
            </CollectionView.Footer>
        </CollectionView>
    </RefreshView>
</ContentPage>
