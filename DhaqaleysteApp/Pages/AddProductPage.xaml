<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="DhaqaleysteApp.Pages.AddProductPage"
    Title="Add Product">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Add Product"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="#4F46E5"/>

        <Entry x:Name="ProductNameEntry" Placeholder="Product Name"/>
        <Editor x:Name="DescriptionEditor" Placeholder="Description" HeightRequest="100"/>
        <Entry x:Name="PriceEntry" Placeholder="Price" Keyboard="Numeric"/>
        <Entry x:Name="QuantityEntry" Placeholder="Quantity" Keyboard="Numeric"/>
        <Entry x:Name="ContactEntry" Placeholder="Contact"/>
        <Entry x:Name="LocationEntry" Placeholder="Location"/>
        <Entry x:Name="CategoryEntry" Placeholder="Category"/>

        <Image x:Name="PreviewImage"
       HeightRequest="150"
       Aspect="AspectFill"
       BackgroundColor="#EEEEEE"/>

        <Button Text="Upload Image"
        Clicked="UploadImage_Clicked"/>
       

        <Button Text="Upload Video Max 50MB"
        Clicked="UploadVideo_Clicked"/>

        <Button Text="Save Product"
        Clicked="SaveProduct_Clicked"
        BackgroundColor="#4F46E5"
        TextColor="White"/>
    </VerticalStackLayout>
</ContentPage>