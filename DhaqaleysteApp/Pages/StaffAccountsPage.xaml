<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:DhaqaleysteApp.Models"
             x:Class="DhaqaleysteApp.Pages.StaffAccountsPage"
             Title="Staff accounts"
             Shell.NavBarIsVisible="False">

    <RefreshView x:Name="Refresh" Refreshing="Refresh_Refreshing">
        <ScrollView>
            <VerticalStackLayout Padding="20,16,20,24" Spacing="16">

                <Border Style="{StaticResource FloatingCircle}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1"
                        HorizontalOptions="Start" SemanticProperties.Description="Back">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="Back_Tapped" /></Border.GestureRecognizers>
                    <Label Text="{StaticResource IconBack}" Style="{StaticResource Icon}" FontSize="26" />
                </Border>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Staff accounts" Style="{StaticResource TitleText}" />
                    <Label Text="Staff create their own accounts with the invite code. Tap a person to change or remove them."
                           FontSize="15" LineHeight="1.3" TextColor="{DynamicResource TextTertiaryColor}" />
                </VerticalStackLayout>

                <!-- Invite code -->
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 22" Padding="18" BackgroundColor="{DynamicResource BannerColor}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="STAFF INVITE CODE" FontSize="12" FontFamily="BodySemibold" CharacterSpacing="0.6"
                               TextColor="{DynamicResource BannerKickerColor}" />
                        <Label x:Name="CodeLabel" Text="…" FontFamily="HeadingHeavy" FontSize="30" CharacterSpacing="2"
                               TextColor="{DynamicResource OnBannerColor}" />
                        <Label x:Name="CodeHint" FontSize="13" LineHeight="1.3" TextColor="{DynamicResource BannerKickerColor}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                            <Button x:Name="ShareButton" Text="Share code" Clicked="Share_Clicked"
                                    BackgroundColor="{DynamicResource BannerButtonColor}" TextColor="{DynamicResource OnBannerButtonColor}" />
                            <Button Grid.Column="1" x:Name="NewCodeButton" Text="New code" Clicked="NewCode_Clicked"
                                    BackgroundColor="Transparent" BorderColor="{DynamicResource BannerKickerColor}" BorderWidth="1.5"
                                    TextColor="{DynamicResource OnBannerColor}" />
                        </Grid>
                        <Label x:Name="TurnOffLabel" Text="Turn staff sign-up off" FontSize="14" FontFamily="BodySemibold"
                               TextColor="{DynamicResource BannerKickerColor}" HorizontalOptions="Center" Margin="0,4,0,0">
                            <Label.GestureRecognizers><TapGestureRecognizer Tapped="TurnOff_Tapped" /></Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>
                </Border>

                <Label x:Name="ErrorLabel" Style="{StaticResource ErrorText}" IsVisible="False" />
                <ActivityIndicator x:Name="Busy" IsRunning="True" />

                <!-- People -->
                <Label Text="People" Style="{StaticResource SectionTitleText}" />
                <Border Style="{StaticResource Card}" Padding="0" StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout x:Name="StaffList" BindableLayout.ItemsSource="{Binding Staff}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:StaffUser">
                                <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12" Padding="16,12">
                                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="Person_Tapped" /></Grid.GestureRecognizers>
                                    <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 22"
                                            BackgroundColor="{DynamicResource PrimarySoftColor}">
                                        <Label Text="{Binding Initials}" FontFamily="Heading" FontSize="15" HorizontalOptions="Center"
                                               VerticalOptions="Center" TextColor="{DynamicResource PrimaryColor}" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding FullName}" FontFamily="BodySemibold" FontSize="15" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Email}" FontSize="13" TextColor="{DynamicResource TextTertiaryColor}" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" Style="{StaticResource Badge}" HeightRequest="24" Padding="10,0" VerticalOptions="Center"
                                            BackgroundColor="{DynamicResource PrimarySoftColor}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsRemoved}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource DangerSoftColor}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsAdmin}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource InkColor}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding StatusText}" FontSize="12" FontFamily="BodySemibold" VerticalOptions="Center"
                                               TextColor="{DynamicResource PrimaryColor}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsRemoved}" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource DangerColor}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsAdmin}" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource OnInkColor}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
