<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="DhaqaleysteApp.Pages.HomePage"
    Title="Dhaqaleyste"
    BackgroundColor="#F5F6FA">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header -->
        <Grid Padding="20,15"
              BackgroundColor="White"
              ColumnDefinitions="*,Auto">

            <Label Text="Dhaqaleyste"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#4F46E5"
                   VerticalOptions="Center"/>

            <Button x:Name="StaffButton"
                    Grid.Column="1"
                    Text="Staff"
                    HeightRequest="45"
                    Padding="16,0"
                    BackgroundColor="#4F46E5"
                    TextColor="White"
                    Clicked="Staff_Clicked"/>
        </Grid>

        <!-- Search -->
        <SearchBar Grid.Row="1"
                   x:Name="SearchBarProducts"
                   Margin="15,10"
                   Placeholder="Search products..."
                   TextChanged="SearchBarProducts_TextChanged"/>

        <!-- Products -->
        <RefreshView Grid.Row="2"
                     x:Name="ProductsRefresh"
                     Refreshing="ProductsRefresh_Refreshing">

            <CollectionView ItemsSource="{Binding Products}">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#DDDDDD"
                                StrokeThickness="1"
                                Padding="15"
                                Margin="15,10"
                                BackgroundColor="White">

                            <VerticalStackLayout Spacing="6">
                                <Image Source="{Binding ImageUrl}"
                                       HeightRequest="160"
                                       Aspect="AspectFill"
                                       IsVisible="{Binding HasImage}"/>

                                <Label Text="{Binding ProductName}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#111827"/>

                                <Label Text="{Binding Description}"
                                       FontSize="14"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation"
                                       TextColor="#4B5563"/>

                                <Label Text="{Binding Price, StringFormat='${0:0.00}'}"
                                       TextColor="#047857"
                                       FontSize="18"
                                       FontAttributes="Bold"/>

                                <Label Text="{Binding Location}"
                                       TextColor="#6B7280"/>

                                <Button Text="View Details"
                                        Clicked="ViewDetails_Clicked"
                                        BackgroundColor="#4F46E5"
                                        TextColor="White"/>
                            </VerticalStackLayout>

                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Padding="30"
                                         Spacing="10">

                        <ActivityIndicator x:Name="LoadingIndicator"
                                           IsRunning="False"
                                           IsVisible="False"
                                           Color="#4F46E5"/>

                        <Label x:Name="EmptyIcon"
                               Text="📦"
                               FontSize="70"
                               HorizontalOptions="Center"/>

                        <Label x:Name="EmptyTitle"
                               Text="No products available"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#111827"
                               HorizontalTextAlignment="Center"/>

                        <Label x:Name="EmptyMessage"
                               Text="Please check back soon."
                               FontSize="14"
                               TextColor="#4B5563"
                               HorizontalTextAlignment="Center"/>

                        <Button x:Name="RetryButton"
                                Text="Try again"
                                IsVisible="False"
                                HorizontalOptions="Center"
                                BackgroundColor="#4F46E5"
                                TextColor="White"
                                Clicked="Retry_Clicked"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
