<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="DhaqaleysteApp.Pages.HomePage"
    Title="MyShop"
    BackgroundColor="#F5F6FA">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header -->
        <Grid Padding="20,15"
      BackgroundColor="White"
      ColumnDefinitions="*,Auto">

            <Label Text="MyShop"
           FontSize="28"
           FontAttributes="Bold"
           TextColor="#4F46E5"
           VerticalOptions="Center"/>

            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                <Button x:Name="AdminButton"
            Text="Admin"
            WidthRequest="90"
            HeightRequest="45"
            BackgroundColor="#4F46E5"
            TextColor="White"
            Clicked="Admin_Clicked"/>

                <Button x:Name="LogoutButton"
            Text="Logout"
            WidthRequest="90"
            HeightRequest="45"
            BackgroundColor="Red"
            TextColor="White"
            Clicked="Logout_Clicked"
            IsVisible="False"/>
            </HorizontalStackLayout>
        </Grid>

        <!-- Search -->
        <SearchBar Grid.Row="1"
           x:Name="SearchBarProducts"
           Margin="15,10"
           Placeholder="Search Products..."
           TextChanged="SearchBarProducts_TextChanged"/>

        <!-- Products -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Products}">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#DDDDDD"
                StrokeThickness="1"
                Padding="15"
                Margin="15,10"
                BackgroundColor="White">

                        <VerticalStackLayout Spacing="6">
                            <Image Source="{Binding ImagePath}"
       HeightRequest="140"
       Aspect="AspectFill"
       IsVisible="{Binding HasImage}"/>
                            <Label Text="{Binding ProductName}"
                       FontSize="20"
                       FontAttributes="Bold"/>

                            <Label Text="{Binding Description}"
                       FontSize="14"/>

                            <Label Text="{Binding Price, StringFormat='Price: ${0}'}"
                       TextColor="Green"
                       FontSize="18"/>

                            <Label Text="{Binding Quantity, StringFormat='Qty: {0}'}"/>

                            <Label Text="{Binding Location}"/>

                            <Button Text="View Details"
        Clicked="ViewDetails_Clicked"
        BackgroundColor="#4F46E5"
        TextColor="White"/>
                        </VerticalStackLayout>

                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Center">

                    <Label Text="📦"
                           FontSize="70"
                           HorizontalOptions="Center"/>

                    <Label Text="No Products Available"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>

                    <Label Text="Admin can add products from Dashboard"
                           FontSize="14"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

        </CollectionView>

    </Grid>

</ContentPage>