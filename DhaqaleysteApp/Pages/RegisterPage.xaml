<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="DhaqaleysteApp.Pages.RegisterPage"
    Title="Register">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="15">

            <Label Text="Create Account"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#4F46E5"/>

            <Entry x:Name="FullNameEntry" Placeholder="Full Name"/>
            <Entry x:Name="PhoneEntry" Placeholder="Phone"/>
            <Entry x:Name="EmailEntry" Placeholder="Email"/>
            <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True"/>
            <Entry x:Name="ConfirmPasswordEntry" Placeholder="Confirm Password" IsPassword="True"/>

            <Button Text="Register"
                    Clicked="Register_Clicked"
                    BackgroundColor="#4F46E5"
                    TextColor="White"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>