<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="DhaqaleysteApp.Pages.AdminDashboardPage"
    Title="Dashboard"
    BackgroundColor="{DynamicResource PageBackgroundColor}">

    <RefreshView x:Name="Refresh" Refreshing="Refresh_Refreshing">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="16">

                <VerticalStackLayout Spacing="4">
                    <Label Text="Dashboard" FontSize="28" FontAttributes="Bold" TextColor="{DynamicResource PrimaryColor}"/>
                    <Label x:Name="WelcomeLabel" TextColor="{DynamicResource TextTertiaryColor}"/>
                </VerticalStackLayout>

                <Label x:Name="ErrorLabel" TextColor="{DynamicResource DangerColor}" IsVisible="False"/>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <Border BackgroundColor="{DynamicResource SurfaceColor}" Stroke="{DynamicResource BorderColor}" Padding="14">
                        <VerticalStackLayout>
                            <Label Text="📦 Products" TextColor="{DynamicResource TextSecondaryColor}"/>
                            <Label x:Name="TotalLabel" Text="…" FontSize="28" FontAttributes="Bold" TextColor="{DynamicResource TextPrimaryColor}"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="{DynamicResource SurfaceColor}" Stroke="{DynamicResource BorderColor}" Padding="14">
                        <VerticalStackLayout>
                            <Label Text="✅ In stock" TextColor="{DynamicResource TextSecondaryColor}"/>
                            <Label x:Name="InStockLabel" Text="…" FontSize="28" FontAttributes="Bold" TextColor="{DynamicResource SuccessColor}"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" BackgroundColor="{DynamicResource SurfaceColor}" Stroke="{DynamicResource BorderColor}" Padding="14">
                        <VerticalStackLayout>
                            <Label Text="⛔ Out of stock" TextColor="{DynamicResource TextSecondaryColor}"/>
                            <Label x:Name="OutOfStockLabel" Text="…" FontSize="28" FontAttributes="Bold" TextColor="{DynamicResource DangerColor}"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BackgroundColor="{DynamicResource SurfaceColor}" Stroke="{DynamicResource BorderColor}" Padding="14">
                        <VerticalStackLayout>
                            <Label Text="⭐ Featured" TextColor="{DynamicResource TextSecondaryColor}"/>
                            <Label x:Name="FeaturedLabel" Text="…" FontSize="28" FontAttributes="Bold" TextColor="{DynamicResource TextPrimaryColor}"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border x:Name="LowStockCard" BackgroundColor="{DynamicResource SurfaceColor}" Stroke="{DynamicResource BorderColor}" Padding="14" IsVisible="False">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Running low" FontAttributes="Bold" TextColor="{DynamicResource TextPrimaryColor}"/>
                        <VerticalStackLayout x:Name="LowStockList" Spacing="2"/>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Add Product" HeightRequest="52" BackgroundColor="{DynamicResource PrimaryColor}" TextColor="{DynamicResource OnPrimaryColor}" Clicked="AddProduct_Clicked"/>
                <Button Text="Manage Products" HeightRequest="52" Clicked="ManageProducts_Clicked"/>
                <Button Text="Categories" HeightRequest="52" Clicked="Categories_Clicked"/>
                <Button x:Name="CompanyButton" Text="Company details" HeightRequest="52" Clicked="Company_Clicked" IsVisible="False"/>
                <Button Text="Sign out" HeightRequest="52" BackgroundColor="{DynamicResource DangerColor}" TextColor="{DynamicResource OnPrimaryColor}" Clicked="Logout_Clicked"/>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
