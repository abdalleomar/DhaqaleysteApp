<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="DhaqaleysteApp.Pages.AdminDashboardPage"
    Title="Admin Dashboard">

    <ScrollView>

        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Admin Dashboard"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#4F46E5"/>

            <Border Stroke="#DDDDDD"
                    StrokeThickness="1">

                <VerticalStackLayout Padding="15">
                    <Label Text="📦 Total Products"/>
                    <Label Text="0"
                           FontSize="30"
                           FontAttributes="Bold"/>
                </VerticalStackLayout>

            </Border>

            <Button Text="Add Product"
        HeightRequest="55"
        BackgroundColor="#4F46E5"
        TextColor="White"
        Clicked="AddProduct_Clicked"/>

            <Button Text="Manage Products"
        HeightRequest="55"
        Clicked="ManageProducts_Clicked"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>