<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DhaqaleysteApp.ViewModels"
             xmlns:models="clr-namespace:DhaqaleysteApp.Models"
             xmlns:views="clr-namespace:DhaqaleysteApp.Views"
             xmlns:loc="clr-namespace:DhaqaleysteApp.Services.Localization"
             x:Class="DhaqaleysteApp.Pages.CategoriesPage"
             x:DataType="vm:CategoriesViewModel"
             Title="{loc:Translate TabCategories}">

    <Grid>
        <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}" IsVisible="{Binding ShowContent}">
            <CollectionView ItemsSource="{Binding Categories}" SelectionMode="None" Margin="10,6">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" />
                </CollectionView.ItemsLayout>

                <CollectionView.Header>
                    <Button Text="{loc:Translate AllProducts}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding SeeAllCommand}" Margin="6,6,6,8" />
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Category">
                        <Grid Padding="6">
                            <Border Style="{StaticResource Card}" HeightRequest="128">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoriesViewModel}}, Path=OpenCategoryCommand, x:DataType=vm:CategoriesViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                            BackgroundColor="{DynamicResource PrimarySoftColor}" HorizontalOptions="Start">
                                        <Label Text="{Binding IconOrDefault}" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="{Binding LocalName}" FontFamily="OpenSansSemibold" FontSize="16"
                                           MaxLines="1" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding ProductCountText}" Style="{StaticResource CaptionText}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <views:StateView IsVisible="{Binding ShowState}"
                         IsLoading="{Binding IsLoading}"
                         Icon="{Binding StateIcon}"
                         Title="{Binding StateTitle}"
                         Message="{Binding StateMessage}"
                         ActionText="{loc:Translate TryAgain}"
                         ActionCommand="{Binding RetryCommand}" />
    </Grid>
</ContentPage>
