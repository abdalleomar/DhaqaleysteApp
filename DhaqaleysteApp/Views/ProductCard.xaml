<?xml version="1.0" encoding="utf-8" ?>
<!-- Product card used in every product grid and carousel. Taps are handled by the parent page. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:DhaqaleysteApp.Models"
             xmlns:loc="clr-namespace:DhaqaleysteApp.Services.Localization"
             x:Class="DhaqaleysteApp.Views.ProductCard"
             x:DataType="models:Product">

    <Border Style="{StaticResource Card}" Padding="0" StrokeShape="RoundRectangle 16">
        <Grid RowDefinitions="Auto,Auto">

            <!-- Photo with badges -->
            <Grid HeightRequest="150" BackgroundColor="{DynamicResource SurfaceVariantColor}">
                <Label Text="{StaticResource IconStore}" Style="{StaticResource Icon}" FontSize="44"
                       TextColor="{DynamicResource TextTertiaryColor}" />
                <Image Source="{Binding ImageUrl}" Aspect="AspectFill" IsVisible="{Binding HasImage}" />

                <Border Style="{StaticResource Badge}"
                        BackgroundColor="{DynamicResource AccentSoftColor}"
                        HorizontalOptions="Start" VerticalOptions="Start" Margin="8"
                        IsVisible="{Binding IsFeatured}">
                    <HorizontalStackLayout Spacing="2">
                        <Label Text="{StaticResource IconStar}" Style="{StaticResource Icon}" FontSize="13"
                               TextColor="{DynamicResource AccentColor}" />
                        <Label Text="{loc:Translate FeaturedBadge}" FontSize="11" FontFamily="OpenSansSemibold"
                               TextColor="{DynamicResource AccentColor}" />
                    </HorizontalStackLayout>
                </Border>

                <Border Style="{StaticResource Badge}"
                        BackgroundColor="{DynamicResource DangerSoftColor}"
                        HorizontalOptions="End" VerticalOptions="End" Margin="8"
                        IsVisible="{Binding IsOutOfStock}">
                    <Label Text="{Binding StockText}" FontSize="11" FontFamily="OpenSansSemibold"
                           TextColor="{DynamicResource DangerColor}" />
                </Border>
            </Grid>

            <!-- Text -->
            <VerticalStackLayout Grid.Row="1" Padding="12,10,12,12" Spacing="2">
                <Label Text="{Binding CategoryDisplayName}" Style="{StaticResource CaptionText}"
                       FontSize="12" MaxLines="1" LineBreakMode="TailTruncation"
                       IsVisible="{Binding HasCategory}" />
                <Label Text="{Binding ProductName}" FontFamily="OpenSansSemibold" FontSize="15"
                       MaxLines="2" LineBreakMode="TailTruncation" HeightRequest="42" />
                <Label Text="{Binding PriceText}" Style="{StaticResource PriceText}" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
