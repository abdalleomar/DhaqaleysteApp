<?xml version="1.0" encoding="UTF-8" ?>
<!-- Light theme colours. Every page refers to these keys with DynamicResource, so switching
     between LightTheme and DarkTheme at runtime recolours the whole app. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="DhaqaleysteApp.Resources.Styles.LightTheme">
    <!-- Brand -->
    <Color x:Key="PrimaryColor">#0B6E5F</Color>
    <Color x:Key="PrimaryPressedColor">#08564A</Color>
    <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
    <Color x:Key="PrimarySoftColor">#E3F2EE</Color>
    <Color x:Key="PrimaryMutedTextColor">#BFE6DC</Color>
    <Color x:Key="PrimaryDeepColor">#128070</Color>

    <!-- Ink: dark buttons, selected chips -->
    <Color x:Key="InkColor">#0E1726</Color>
    <Color x:Key="OnInkColor">#FFFFFF</Color>
    <Color x:Key="InkRaisedColor">#24314A</Color>
    <Color x:Key="OnInkMutedColor">#B6C0CE</Color>

    <Color x:Key="AccentColor">#8A4A04</Color>
    <Color x:Key="AccentSoftColor">#FEF3C7</Color>
    <Color x:Key="WarningCardColor">#FFF8EB</Color>
    <Color x:Key="WarningBorderColor">#F4DEB5</Color>
    <Color x:Key="WarningTextColor">#6B3A03</Color>

    <!-- Surfaces -->
    <Color x:Key="PageBackgroundColor">#F5F6F4</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceVariantColor">#E6EEF0</Color>
    <Color x:Key="SegmentBackgroundColor">#EEF0F2</Color>
    <Color x:Key="BorderColor">#E4E7EC</Color>
    <Color x:Key="DividerColor">#EEF0F2</Color>
    <Color x:Key="PlaceholderIconColor">#8A97A3</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#0E1726</Color>
    <Color x:Key="TextSecondaryColor">#3F4857</Color>
    <Color x:Key="TextTertiaryColor">#5B6576</Color>
    <Color x:Key="PlaceholderColor">#6B7380</Color>

    <!-- Status -->
    <Color x:Key="SuccessColor">#08664F</Color>
    <Color x:Key="SuccessSoftColor">#E3F2EE</Color>
    <Color x:Key="OpenDotColor">#12A06A</Color>
    <Color x:Key="DangerColor">#A3261B</Color>
    <Color x:Key="DangerSoftColor">#FDECEA</Color>
    <Color x:Key="WhatsAppColor">#12753F</Color>
    <Color x:Key="FavoriteColor">#C0263D</Color>

    <!-- Home highlight banner -->
    <Color x:Key="BannerColor">#0B6E5F</Color>
    <Color x:Key="OnBannerColor">#FFFFFF</Color>
    <Color x:Key="BannerButtonColor">#FFFFFF</Color>
    <Color x:Key="OnBannerButtonColor">#0B6E5F</Color>
    <Color x:Key="BannerImageColor">#128070</Color>
    <Color x:Key="BannerKickerColor">#BFE6DC</Color>

    <!-- Category tile tints (background / icon) -->
    <Color x:Key="Tint1Bg">#E3F2EE</Color><Color x:Key="Tint1Fg">#0B6E5F</Color>
    <Color x:Key="Tint2Bg">#E8EAF8</Color><Color x:Key="Tint2Fg">#3D47A8</Color>
    <Color x:Key="Tint3Bg">#FDF0DC</Color><Color x:Key="Tint3Fg">#8A4A04</Color>
    <Color x:Key="Tint4Bg">#F6E6EA</Color><Color x:Key="Tint4Fg">#9B2340</Color>
    <Color x:Key="Tint5Bg">#E6EEF0</Color><Color x:Key="Tint5Fg">#2D5866</Color>
    <Color x:Key="Tint6Bg">#EEF1E6</Color><Color x:Key="Tint6Fg">#4F5A2E</Color>
</ResourceDictionary>
