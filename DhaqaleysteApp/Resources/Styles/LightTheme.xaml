<?xml version="1.0" encoding="UTF-8" ?>
<!-- Light theme colours. Every page refers to these keys with DynamicResource, so switching
     between LightTheme and DarkTheme at runtime recolours the whole app. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="DhaqaleysteApp.Resources.Styles.LightTheme">
    <Color x:Key="PrimaryColor">#4F46E5</Color>
    <Color x:Key="PrimaryPressedColor">#4338CA</Color>
    <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
    <Color x:Key="PrimarySoftColor">#EEF2FF</Color>
    <Color x:Key="AccentColor">#D97706</Color>
    <Color x:Key="AccentSoftColor">#FEF3C7</Color>

    <Color x:Key="PageBackgroundColor">#F5F6FA</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceVariantColor">#F3F4F6</Color>
    <Color x:Key="BorderColor">#E5E7EB</Color>

    <Color x:Key="TextPrimaryColor">#111827</Color>
    <Color x:Key="TextSecondaryColor">#4B5563</Color>
    <Color x:Key="TextTertiaryColor">#6B7280</Color>
    <Color x:Key="PlaceholderColor">#9CA3AF</Color>

    <Color x:Key="SuccessColor">#047857</Color>
    <Color x:Key="SuccessSoftColor">#D1FAE5</Color>
    <Color x:Key="DangerColor">#B91C1C</Color>
    <Color x:Key="DangerSoftColor">#FEE2E2</Color>
    <Color x:Key="WhatsAppColor">#15803D</Color>
    <Color x:Key="FavoriteColor">#E11D48</Color>
</ResourceDictionary>
