<?xml version="1.0" encoding="UTF-8" ?>
<!-- Dark theme colours (same keys as LightTheme). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="DhaqaleysteApp.Resources.Styles.DarkTheme">
    <Color x:Key="PrimaryColor">#6366F1</Color>
    <Color x:Key="PrimaryPressedColor">#4F46E5</Color>
    <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
    <Color x:Key="PrimarySoftColor">#1E1B4B</Color>
    <Color x:Key="AccentColor">#FBBF24</Color>
    <Color x:Key="AccentSoftColor">#422006</Color>

    <Color x:Key="PageBackgroundColor">#0B0F19</Color>
    <Color x:Key="SurfaceColor">#151B2B</Color>
    <Color x:Key="SurfaceVariantColor">#1F2937</Color>
    <Color x:Key="BorderColor">#2A3245</Color>

    <Color x:Key="TextPrimaryColor">#F3F4F6</Color>
    <Color x:Key="TextSecondaryColor">#B4BCC8</Color>
    <Color x:Key="TextTertiaryColor">#8B93A7</Color>
    <Color x:Key="PlaceholderColor">#6B7280</Color>

    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="SuccessSoftColor">#064E3B</Color>
    <Color x:Key="DangerColor">#F87171</Color>
    <Color x:Key="DangerSoftColor">#450A0A</Color>
    <Color x:Key="WhatsAppColor">#16A34A</Color>
    <Color x:Key="FavoriteColor">#FB7185</Color>
</ResourceDictionary>
