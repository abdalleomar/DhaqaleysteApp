<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Dhaqaleyste design system.
    Fonts: Plus Jakarta Sans for headings and prices ("Heading", "HeadingHeavy"), Inter for everything else
    ("Body", "BodyMedium", "BodySemibold"), Material Design Icons ("Icons").
    Colours come from LightTheme.xaml / DarkTheme.xaml through DynamicResource so the theme can change at runtime.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===================== Pages and navigation ===================== -->

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource PageBackgroundColor}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{DynamicResource PageBackgroundColor}" />
        <Setter Property="BarTextColor" Value="{DynamicResource TextPrimaryColor}" />
        <Setter Property="IconColor" Value="{DynamicResource TextPrimaryColor}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource PageBackgroundColor}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource TextPrimaryColor}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource TextPrimaryColor}" />
        <Setter Property="Shell.DisabledColor" Value="{DynamicResource TextTertiaryColor}" />
        <Setter Property="Shell.UnselectedColor" Value="{DynamicResource TextTertiaryColor}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <!-- The app draws its own bottom tab bar (Views/TabBarView), so the platform one is hidden. -->
        <Setter Property="Shell.TabBarIsVisible" Value="False" />
    </Style>

    <!-- ===================== Text ===================== -->

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
        <Setter Property="FontFamily" Value="Body" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="Span">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
    </Style>

    <Style x:Key="TitleText" TargetType="Label">
        <Setter Property="FontFamily" Value="Heading" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="CharacterSpacing" Value="-0.4" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
    </Style>

    <Style x:Key="HeadlineText" TargetType="Label">
        <Setter Property="FontFamily" Value="Heading" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="LineHeight" Value="1.15" />
        <Setter Property="CharacterSpacing" Value="-0.4" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
    </Style>

    <Style x:Key="SectionTitleText" TargetType="Label">
        <Setter Property="FontFamily" Value="Heading" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
    </Style>

    <Style x:Key="BodyText" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="1.4" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondaryColor}" />
    </Style>

    <Style x:Key="CaptionText" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{DynamicResource TextTertiaryColor}" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="BodySemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
    </Style>

    <Style x:Key="PriceText" TargetType="Label">
        <Setter Property="FontFamily" Value="Heading" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <Style x:Key="ErrorText" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource DangerColor}" />
    </Style>

    <Style x:Key="LinkText" TargetType="Label">
        <Setter Property="FontFamily" Value="BodySemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <!-- Icon glyph. Set Text to an Icon... resource. -->
    <Style x:Key="Icon" TargetType="Label">
        <Setter Property="FontFamily" Value="Icons" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- ===================== Inputs ===================== -->

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource PlaceholderColor}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="Body" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource PlaceholderColor}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="Body" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource PlaceholderColor}" />
        <Setter Property="CancelButtonColor" Value="{DynamicResource TextTertiaryColor}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="Body" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
        <Setter Property="TitleColor" Value="{DynamicResource PlaceholderColor}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="Body" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <Style TargetType="IndicatorView">
        <Setter Property="IndicatorColor" Value="{DynamicResource BorderColor}" />
        <Setter Property="SelectedIndicatorColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="IndicatorSize" Value="7" />
    </Style>

    <!-- Rounded field container used around Entry / Picker / Editor / SearchBar. -->
    <Style x:Key="InputBox" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="Stroke" Value="{DynamicResource BorderColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="14,2" />
        <Setter Property="MinimumHeightRequest" Value="52" />
    </Style>

    <!-- ===================== Buttons ===================== -->

    <!-- Default: filled brand button. -->
    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimaryColor}" />
        <Setter Property="FontFamily" Value="BodySemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="MinimumWidthRequest" Value="44" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Dark "ink" button: Add product, Filters, selected chips. -->
    <Style x:Key="InkButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource InkColor}" />
        <Setter Property="TextColor" Value="{DynamicResource OnInkColor}" />
        <Setter Property="FontFamily" Value="BodySemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <!-- Outlined button: Call. -->
    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
        <Setter Property="BorderColor" Value="{DynamicResource TextPrimaryColor}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="FontFamily" Value="BodySemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimarySoftColor}" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="FontFamily" Value="BodySemibold" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource DangerColor}" />
        <Setter Property="TextColor" Value="#FFFFFF" />
        <Setter Property="FontFamily" Value="BodySemibold" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style x:Key="WhatsAppButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource WhatsAppColor}" />
        <Setter Property="TextColor" Value="#FFFFFF" />
        <Setter Property="FontFamily" Value="BodySemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style x:Key="TextButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="FontFamily" Value="BodySemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <!-- ===================== Containers ===================== -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="Stroke" Value="{DynamicResource BorderColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="BigCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="StrokeShape" Value="RoundRectangle 22" />
    </Style>

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="Stroke" Value="{DynamicResource BorderColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 19" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="HeightRequest" Value="38" />
    </Style>

    <Style x:Key="InkChip" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="BackgroundColor" Value="{DynamicResource InkColor}" />
        <Setter Property="Stroke" Value="{DynamicResource InkColor}" />
    </Style>

    <Style x:Key="ActiveChip" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimarySoftColor}" />
        <Setter Property="Stroke" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <!-- Round white button over a photo (back, share, favourite). -->
    <Style x:Key="FloatingCircle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 22" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
    </Style>

    <!-- Rounded icon square in list rows and tiles. -->
    <Style x:Key="IconSquare" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimarySoftColor}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="Color" Value="{DynamicResource BorderColor}" />
    </Style>

    <Style x:Key="Divider" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{DynamicResource DividerColor}" />
    </Style>

</ResourceDictionary>
